pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
metadata:
  name: kaniko
  namespace: jenkins
spec:
  containers:
  - name: kaniko
    image: gcr.io/kaniko-project/executor:debug
    command:
    - /busybox/cat
    tty: true
    volumeMounts:
    - name: docker-credentials
      mountPath: /kaniko/.docker
    - name: workspace-volume
      mountPath: /home/jenkins/agent
  volumes:
  - name: docker-credentials
    secret:
      secretName: dockerhub-secret
      items:
      - key: .dockerconfigjson
        path: config.json
"""
        }
    }

    environment {
        IMAGE_NAME = 'gizemk/devops-case-app'
        IMAGE_TAG  = "${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                // Clone the repo including submodules
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    extensions: [
                        [$class: 'SubmoduleOption',
                         disableSubmodules: false,
                         parentCredentials: true,
                         recursiveSubmodules: true,
                         trackingSubmodules: false]
                    ],
                    userRemoteConfigs: [[
                        credentialsId: 'dockerhub-credentials',
                        url: 'https://github.com/gzmkcc/devops_project.git'
                    ]]
                ])
            }
        }

        stage('Build & Push') {
            steps {
                container('kaniko') {
                    // Kaniko builds the image from Dockerfile and pushes it
                    // to DockerHub in a single step — no Docker daemon needed
                    sh """
                        /kaniko/executor \
                          --context=. \
                          --dockerfile=docker/Dockerfile \
                          --destination=${IMAGE_NAME}:${IMAGE_TAG} \
                          --destination=${IMAGE_NAME}:latest
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Image ${IMAGE_NAME}:${IMAGE_TAG} successfully pushed to DockerHub!"
        }
        failure {
            echo "Pipeline failed."
        }
    }
}